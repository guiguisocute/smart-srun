#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

PROG=/usr/bin/srunnet

# Starting this service is not the same as switching automatic authentication
# on. The service answers the local control socket so the interface and the CLI
# can talk to it; whether it authenticates on its own is the `enabled` setting
# inside /etc/smart-srun/config.json, which ships off. Conflating the two is how
# a fresh install starts logging in with credentials nobody has entered yet.
start_service() {
	procd_open_instance
	procd_set_param command "$PROG" daemon

	# retry=0 means unlimited respawn, and it is deliberate. With a finite
	# budget, manual actions that restart the service burn through it -- the
	# Python version's 5-attempt budget was exhausted exactly that way, after
	# which the daemon stayed dead until somebody rebooted the router.
	procd_set_param respawn 3600 5 0

	# The daemon cancels its work, writes its last state snapshot and releases
	# its lock on SIGTERM, and gives a worker that ignores cancellation ten
	# seconds before giving up on it. procd's default five seconds would cut
	# that short and SIGKILL a shutdown that was about to finish.
	procd_set_param term_timeout 15

	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# No stop_service.
#
# procd knows which process it started and stops that one. The Python version
# needed to hunt through /proc because the daemon, the CLI and the update worker
# were all `client.py` and a blunt stop killed installs halfway through. Here
# the update worker is a separate procd service running its own copy of the
# binary, so stopping this service stops this service -- which is what spec 02
# requires and what a process hunt could never guarantee.
